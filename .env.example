# Optional. The project runs without a .env file; these override the demo
# defaults in src/env.ts. Copy to .env if you want to change anything.

# SQLite file (local). For Postgres, swap the adapter in payload.config.ts.
DATABASE_URL=file:./demo.db

# Signs auth tokens. Use a long random string outside of local demos.
PAYLOAD_SECRET=demo-secret-change-me-in-production

# Guards the live-preview route (/next/preview).
PREVIEW_SECRET=demo-preview-secret

# Public base URL, used for absolute URLs in sitemap.xml.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
